# HeartGuard Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
#
# Default configuration is DEMO MODE (ALERTS_ENABLED=false).
# The application is fully functional without any credentials in demo mode.
# ============================================================

# --- Application Environment ---
# Options: development (default), testing, production
ENVIRONMENT=development

# Application URL (used for CORS and display)
APP_URL=http://localhost:8000

# Allowed CORS origins (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8501

# CORS origins for the FastAPI backend
HEARTGUARD_CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Debug mode — MUST be false in production
DEBUG=false

# Secret key — MUST be a strong random value in production
SECRET_KEY=heartguard-change-this-in-production

# --- Twilio (Emergency Alerts) ---
# Leave blank to run in safe Demo Mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOCTOR_PHONE_NUMBER=
EMERGENCY_CONTACT_PHONE_NUMBER=
ALERTS_ENABLED=false

# --- Logging ---
# Production default: WARNING, Development default: INFO
LOG_LEVEL=INFO

# Set to true to enable rotating file logs (default: true in production)
LOG_TO_FILE=false

# Log rotation settings
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5

# --- Database ---
# SQLite database paths (relative to project root or absolute)
# AUTH_DB_PATH=data/auth/heartguard_auth.db
# AUDIT_DB_PATH=data/security/audit.db
# ALERTS_DB_PATH=data/alerts/alerts.db
# ASSESSMENTS_DB_PATH=data/assessments/assessments.db
# REVIEWS_DB_PATH=data/assessments/reviews.db
# RECOMMENDATIONS_DB_PATH=data/assessments/recommendations.db

# Database timeouts
DB_TIMEOUT_SECONDS=10.0
DB_BUSY_TIMEOUT_MS=5000

# --- File Storage ---
# REPORT_DIR=reports
# TEMP_DIR=data/tmp
# MODEL_DIR=models

# --- Timeouts ---
TWILIO_TIMEOUT_SECONDS=10
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2
REPORT_GENERATION_TIMEOUT_SECONDS=30

# --- Retention ---
REPORT_RETENTION_DAYS=30
TEMP_FILE_RETENTION_HOURS=24
MAX_REPORTS_PER_USER=100

# --- Admin Seeding (scripts/create_admin.py) ---
# Used only by CLI provisioning scripts — never hard-code real credentials here.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Reviewer Seeding (scripts/create_reviewer.py) ---
REVIEWER_EMAIL=
REVIEWER_PASSWORD=
