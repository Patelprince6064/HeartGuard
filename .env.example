# HeartGuard Environment Variables Example
# Copy this file to .env and configure real credentials for Live Mode.
# In development, ALERTS_ENABLED=false by default (Safe Demo Mode).

TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=your_twilio_number
DOCTOR_PHONE_NUMBER=doctor_number
EMERGENCY_CONTACT_PHONE_NUMBER=emergency_contact_number
ALERTS_ENABLED=false
