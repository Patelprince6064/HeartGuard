# HeartGuard Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit the real .env file to version control.
#
# Default configuration is DEMO MODE (ALERTS_ENABLED=false).
# The application is fully functional without any credentials in demo mode.
# ============================================================

# --- Twilio (Phase 8 — Emergency Alerts) ---
# Leave blank to run in safe Demo Mode.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
DOCTOR_PHONE_NUMBER=
EMERGENCY_CONTACT_PHONE_NUMBER=
ALERTS_ENABLED=false

# --- Application (Phase 9) ---
# Set a strong random value in production.
SECRET_KEY=heartguard-change-this-in-production

# Set to false in production.
DEBUG=false

# --- Admin Seeding (Phase 9) ---
# Used only by scripts/create_admin.py — never hard-code real credentials here.
ADMIN_EMAIL=
ADMIN_PASSWORD=
